#!/bin/bash
# SentinelWeb Installation Script

echo "🛡️ Installing SentinelWeb..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check root
if [ "$EUID" -ne 0 ]; then 
    echo -e "${YELLOW}⚠️  Please run as root for full installation${NC}"
    exit 1
fi

# Install system packages
echo -e "${GREEN}[*] Installing system packages...${NC}"
apt-get update
apt-get install -y nikto nmap whatweb git openssl python3-pip gobuster

# Install testssl.sh
echo -e "${GREEN}[*] Installing testssl.sh...${NC}"
git clone --depth 1 https://github.com/drwetter/testssl.sh.git /opt/testssl
ln -sf /opt/testssl/testssl.sh /usr/local/bin/testssl

# Install Python packages
echo -e "${GREEN}[*] Installing Python dependencies...${NC}"
pip3 install -r requirements.txt

echo -e "${GREEN}[✓] SentinelWeb installation complete!${NC}"
echo -e "${YELLOW}Run: python3 sentinelweb.py --help${NC}"
